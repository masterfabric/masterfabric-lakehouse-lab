# Lab-only credentials. Every service binds to 127.0.0.1. Change these before exposing anything.
# `make env` copies this file to .env (gitignored) if .env does not exist yet.
LAKE_S3_ACCESS_KEY=lakehouse
LAKE_S3_SECRET_KEY=lakehouse-lab-change-me
LAKE_S3_REGION=us-east-1
LAKE_WAREHOUSE=s3://warehouse/

# Host ports (all on 127.0.0.1). Chosen to stay clear of common dev ports (3000, 5000, 8080, 8081).
PORT_S3_API=19000
PORT_S3_CONSOLE=19001
PORT_CATALOG=18181
PORT_TRINO=18080
PORT_SPARK_UI=14040
PORT_SPARK_HISTORY=18090
PORT_JUPYTER=18888

# Spark driver memory for pipeline jobs.
SPARK_DRIVER_MEMORY=3g

# Lineage profile (Marquez). Host ports on 127.0.0.1; lab-only database password.
PORT_MARQUEZ_API=15100
PORT_MARQUEZ_WEB=13100
MARQUEZ_DB_PASSWORD=marquez-lab-only
